# Arize
ARIZE_API_KEY=
ARIZE_SPACE_ID=
# Self-hosted endpoints: set API and Flight hosts, or a single host that serves both.
ARIZE_API_HOST=
ARIZE_FLIGHT_HOST=
ARIZE_SINGLE_HOST=
# Path to a CA bundle if your Arize endpoints use an internal certificate authority.
ARIZE_SSL_CA_CERT=

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=
# A region such as asia-northeast3, or "global". "global" does not guarantee data residency.
GOOGLE_CLOUD_LOCATION=
# <project>.<dataset> for batch input and output tables; must be in the job's region.
BQ_DATASET=
GEMINI_MODEL=

# Where run state and intermediate files are kept.
RUNS_DIR=runs
